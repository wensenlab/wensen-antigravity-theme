  "patterns": [
    {
      "regex": "^Pinned(\\s+Conversations)?$",
      "flags": "i",
      "replace": "置顶对话"
    },
    {
      "regex": "^Recent(\\s+Conversations)?$",
      "flags": "i",
      "replace": "最近会话"
    },
    {
      "regex": "^(All\\s+)?Conversations$",
      "flags": "i",
      "replace": "会话列表"
    },
    {
      "regex": "^See\\s+all\\s*\\((\\d+)\\)$",
      "flags": "i",
      "replace": "查看全部 ($1)"
    },
    {
      "regex": "^See\\s+all$",
      "flags": "i",
      "replace": "查看全部"
    },
    {
      "regex": "^(\\d+)\\s+active\\s+conversations$",
      "flags": "i",
      "replace": "$1 个进行中的会话"
    },
    {
      "regex": "^(\\d+)\\s+files?\\s+changed$",
      "flags": "i",
      "replace": "$1 个文件变更"
    },
    {
      "regex": "^Show\\s+(\\d+)\\s+breakdowns?$",
      "flags": "i",
      "replace": "展开明细 ($1 项)"
    },
    {
      "regex": "^Worked for\\s+(\\d+[smhd])$",
      "flags": "i",
      "replace": "已工作 $1"
    },
    {
      "regex": "^Thought for\\s+(\\d+[smhd])$",
      "flags": "i",
      "replace": "已思考 $1"
    }
  ],
  "exclusions": [
    "code",
    "pre",
    "kbd",
    "samp",
    "[class*=\"language-\"]",
    ".monaco-editor",
    ".xterm",
    ".prose",
    ".markdown",
    "[class*=\"chat-message\"]",
    "input",
    "textarea",
    "[contenteditable=\"true\"]",
    "[class*=\"group/file-title\"]",
    "[class*=\"file-title\"]",
    "[class*=\"file-path\"]",
    "[data-path]"
  ]
}
